<?xml version="1.0" encoding="UTF-8"?>
<!--
    2026-08-24 기준

      로깅 정책
       1) docker logs / 콘솔이 프레임워크 잡음으로 도배되지 않게
       2) 하루 단위 txt 파일로 저장 — app.YYYY-MM-DD.log (자정 기준 새 파일로)
            - 오늘 파일: app.log
            - 자정 지남: app.YYYY-MM-DD.0.log
       3) 디스크가 로그로 꽉 차지 않게 — 30일 보관 + 전체 3GB 상한(초과분 자동 삭제)
-->
<configuration>

    <!-- Spring Boot 기본 로깅 설정 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 로그 디렉토리 설정 -->
    <property name="LOG_DIR" value="${LOG_DIR:-/app/logs}"/>

    <!-- 로그 파일 이름 설정 -->
    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- 콘솔 로그 패턴 설정 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 파일 - 하루 1개 txt. 하루치 100MB 이상이면 .%i 로 나뉘게 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>   <!-- 하루 로그가 이보다 크면 .%i 로 분할 -->
            <maxHistory>30</maxHistory>        <!-- 30일치만 보관, 오래된 건 자동 삭제 -->
            <totalSizeCap>3GB</totalSizeCap>   <!-- 전체 합이 3GB를 넘으면 오래된 것부터 삭제(디스크 안전장치) -->
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- root logger 설정 (WARN으로 설정해서 잡로그 줄이기) -->
    <!-- 문제 추적이 필요하면 이 값만 DEBUG/INFO로 잠깐 올리면 됨 -->
    <logger name="org.hibernate.SQL" level="OFF"/>                       <!-- SQL 원문 -->
    <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>             <!-- 바인딩 파라미터 -->
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.coyote" level="WARN"/>
    <logger name="org.apache.tomcat" level="WARN"/>

    <!-- Flyway 로그는 INFO 유지 -->
    <logger name="org.flywaydb" level="INFO"/>

    <!-- 애플리케이션 코드는 INFO 유지 -->
    <logger name="com.jpkocommunity" level="INFO"/>

    <!-- 운영 환경: 콘솔 + 파일 -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- 개발환경/기타: 콘솔만 -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>


</configuration>